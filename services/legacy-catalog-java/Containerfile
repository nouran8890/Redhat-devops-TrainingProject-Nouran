FROM docker.io/library/maven:3.9-eclipse-temurin-17 AS build

WORKDIR /build

COPY pom.xml .
COPY src ./src

RUN mvn package -DskipTests

FROM docker.io/library/eclipse-temurin:17-jre

WORKDIR /app

COPY --from=build /build/target/*.jar /app/catalog.jar

EXPOSE 8081

CMD ["java", "-jar", "/app/catalog.jar"]